# Public base URL of your PocketBase instance, no trailing slash.
# This is hit directly from the browser, so it must NOT be behind Cloudflare Access.
#
# Local development (docker compose up -d):
NUXT_PUBLIC_POCKETBASE_URL=http://localhost:8090
#
# Isolated worktree stack (PB_PORT=809<n> docker compose -p storage-<slot> up -d):
# NUXT_PUBLIC_POCKETBASE_URL=http://localhost:809<n>
#
# Remote instance:
# NUXT_PUBLIC_POCKETBASE_URL=https://pb.example.com
